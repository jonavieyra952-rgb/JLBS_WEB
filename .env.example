# Estos identificadores se obtienen en Google Analytics y Google Ads.
# No son contraseñas, pero deben corresponder a las cuentas oficiales de JLBS.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Cada acción de conversión de Google Ads entrega un valor AW-ID/ETIQUETA.
VITE_GOOGLE_ADS_FORM_SEND_TO=AW-XXXXXXXXX/FORM_LABEL
VITE_GOOGLE_ADS_PHONE_SEND_TO=AW-XXXXXXXXX/PHONE_LABEL
VITE_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-XXXXXXXXX/WHATSAPP_LABEL
